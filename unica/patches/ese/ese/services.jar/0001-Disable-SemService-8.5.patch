Subject: [PATCH] Do not advertise or start absent embedded Secure Element on A21s

--- a/smali/com/android/server/SystemConfig.smali
+++ b/smali/com/android/server/SystemConfig.smali
@@ -2530,7 +2530,7 @@
 
     invoke-static {v2, v8}, Landroid/util/Slog;->d(Ljava/lang/String;Ljava/lang/String;)I
 
-    const-string/jumbo v8, "eSE_COS: UT8.0U"
+    const-string/jumbo v8, "eSE_COS: "
 
     invoke-static {v2, v8}, Landroid/util/Slog;->d(Ljava/lang/String;Ljava/lang/String;)I
 
@@ -2657,6 +2657,8 @@
     move v13, v10
 
     :goto_14
+    const/4 v13, 0x0
+
     const-string/jumbo v0, "support eSE: "
 
     invoke-static {v0, v2, v13}, Lcom/android/server/DeviceIdleController$$ExternalSyntheticOutline0;->m$1(Ljava/lang/String;Ljava/lang/String;Z)V
--- a/smali/com/android/server/SystemServer$$ExternalSyntheticLambda10.smali
+++ b/smali/com/android/server/SystemServer$$ExternalSyntheticLambda10.smali
@@ -26,29 +26,6 @@
 
     move-result-object v1
 
-    const-string/jumbo v2, "SemService"
-
-    invoke-virtual {v1, v2}, Lcom/android/server/utils/TimingsTraceAndSlog;->traceBegin(Ljava/lang/String;)V
-
-    :try_start_0
-    const-class v3, Lcom/android/server/SemService;
-
-    invoke-static {v2, v3}, Landroid/os/ServiceManager;->addService(Ljava/lang/String;Ljava/lang/Class;)V
-    :try_end_0
-    .catchall {:try_start_0 .. :try_end_0} :catchall_0
-
-    goto :goto_0
-
-    :catchall_0
-    move-exception v2
-
-    const-string v3, "Failure starting SemService"
-
-    invoke-static {v3, v2}, Lcom/android/server/SystemServer;->reportWtf(Ljava/lang/String;Ljava/lang/Throwable;)V
-
-    :goto_0
-    invoke-virtual {v1}, Landroid/util/TimingsTraceLog;->traceEnd()V
-
     const-string v2, "Blockchain Service"
 
     invoke-virtual {v1, v2}, Lcom/android/server/utils/TimingsTraceAndSlog;->traceBegin(Ljava/lang/String;)V
